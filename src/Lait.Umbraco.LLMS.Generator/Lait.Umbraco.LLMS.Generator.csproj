<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <StaticWebAssetBasePath>App_Plugins/LaitLlms</StaticWebAssetBasePath>

    <!-- NuGet / Marketplace metadata (used by `dotnet pack`) -->
    <PackageId>Lait.Umbraco.LLMS.Generator</PackageId>
    <Title>LLMs.txt Generator for Umbraco</Title>
    <Version>1.0.0</Version>
    <Authors>LAIT, Anders Bootsmann Overvad</Authors>
    <Company>LAIT</Company>
    <Copyright>Copyright (c) 2026 LAIT</Copyright>
    <Description>Build your /llms.txt from the Umbraco 17 backoffice. Editors compose it from blocks: text, headings, links (to Umbraco pages or external URLs) and sections that list the pages under a node, optionally with all descendants, filtered by depth, document type, hidden pages and a page limit. One file per site/domain, follows the llmstxt.org format, live preview while editing, regenerated automatically when content is published. Dashboard in English and Danish.</Description>
    <PackageTags>umbraco umbraco-marketplace llms llms.txt llmstxt ai geo seo</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The Marketplace fetches umbraco-marketplace.json from the repo root of this URL. -->
    <PackageProjectUrl>https://github.com/laitdevelopers/Lait.Umbraco.LLMS.Generator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/laitdevelopers/Lait.Umbraco.LLMS.Generator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lait.Umbraco.LLMS.Generator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.0.0" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
